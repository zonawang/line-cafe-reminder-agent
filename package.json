{
  "name": "line-cafe-reminder-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LINE cafe agent with Gemini function calling and secure Cloud Tasks reminders.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/tasks": "^6.2.1",
    "@google/genai": "^2.0.0",
    "@line/bot-sdk": "^10.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
